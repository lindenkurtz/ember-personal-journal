# Supabase (build-time, bundled into the SPA — publishable key only, never the secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID public key for Web Push. Generate a keypair with:
#   npx web-push generate-vapid-keys
# Paste the public key here; the private key stays a Worker secret.
VITE_VAPID_PUBLIC_KEY=
