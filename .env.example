# Copy to .env (gitignored). Every VITE_* var is baked into the client bundle at
# build time, so these must also be set in Cloudflare Pages env vars — .env is
# local-only. Never put a server-side secret behind a VITE_ prefix.

VITE_SUPABASE_URL=https://<project>.supabase.co

# The publishable key (sb_publishable_...), which authenticates as `anon` and is
# subject to RLS. NOT the sb_secret_ key — that lives only in Wrangler secrets.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# From `npx web-push generate-vapid-keys`. Optional: without it the build still
# succeeds and the Settings push toggle stays disabled with a banner.
VITE_VAPID_PUBLIC_KEY=

# Server-side vars (ANTHROPIC_API_KEY, PLAID_*, SUPABASE_SERVICE_KEY) do NOT go
# here — put them in .dev.vars for `npm run pages:dev`, and in the Cloudflare
# Pages dashboard for deploys. See docs/FINANCE.md for the Plaid set.
